#!/bin/bash

# contextual - Contextual Development Tools CLI
# Main entrypoint for contextual development tools

set -euo pipefail

# Version information (hardcoded as per specification)
CONTEXTUAL_VERSION="1.0.0"

# Script configuration
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPTS_DIR="$SCRIPT_DIR/scripts"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored output
print_error() {
    echo -e "${RED}[contextual] ERROR:${NC} $1" >&2
}

print_info() {
    echo -e "${BLUE}[contextual] INFO:${NC} $1"
}

# Function to show contextual CLI help
show_help() {
    cat << EOF
Contextual Development Tools CLI v$CONTEXTUAL_VERSION

USAGE:
    contextual <command> [PROJECT_ROOT] [options]

COMMANDS:
    install       Install contextual development tools into a project
    update        Update contextual development tools in a project
    dev           Development utilities (run 'contextual dev help' for details)
    autocomplete  Install shell completion (bash/zsh)
    help          Show this help message
    version       Show version information

EXAMPLES:
    contextual install /path/to/project
    contextual install /path/to/project --agent cursor
    contextual help
    contextual version

For more information about a specific command, run:
    contextual <command> --help

EOF
}

# Function to show version information
show_version() {
    echo "contextual v$CONTEXTUAL_VERSION"
}

# Function to handle script execution with error wrapping
execute_script() {
    local script_name="$1"
    local script_path="$SCRIPTS_DIR/$script_name"
    shift # Remove script name from arguments
    
    if [[ ! -f "$script_path" ]]; then
        print_error "Script not found: $script_name"
        print_error "Available scripts: install.sh, run-tests.sh"
        exit 1
    fi
    
    if [[ ! -x "$script_path" ]]; then
        print_error "Script is not executable: $script_path"
        exit 1
    fi
    
    # Add contextual wrapper error message before executing
    print_info "Executing $script_name with arguments: $*"
    
    # Execute the script and capture exit code
    if "$script_path" "$@"; then
        print_info "$script_name completed successfully"
    else
        local exit_code=$?
        print_error "$script_name failed with exit code $exit_code"
        exit $exit_code
    fi
}

# Function to show usage when no arguments provided
show_usage() {
    echo "Contextual Development Tools CLI v$CONTEXTUAL_VERSION"
    echo ""
    echo "Usage: contextual <command> [options]"
    echo ""
    echo "Commands:"
    echo "  install       Install contextual development tools into a project"
    echo "  dev           Development utilities (run 'contextual dev help' for details)"
    echo "  autocomplete  Install shell completion (bash/zsh)"
    echo "  help          Show help message"
    echo "  version       Show version information"
    echo ""
    echo "Run 'contextual help' for more information."
}

# Main function
main() {
    # Check if scripts directory exists
    if [[ ! -d "$SCRIPTS_DIR" ]]; then
        print_error "Scripts directory not found: $SCRIPTS_DIR"
        print_error "Make sure you're running this script from the contextual project root."
        exit 1
    fi
    
    # Handle case when no arguments provided
    if [[ $# -eq 0 ]]; then
        show_usage
        exit 0
    fi
    
    # Parse command
    local command="$1"
    shift # Remove command from arguments
    
    case "$command" in
        "install")
            execute_script "install.sh" "$@"
            ;;
        "update")
            execute_script "install.sh" "$@"
            ;;
        "dev")
            # Run dev utilities from scripts/dev directory
            local dev_script="$SCRIPTS_DIR/dev/cli.sh"
            if [[ ! -f "$dev_script" ]]; then
                print_error "Dev script not found: $dev_script"
                exit 1
            fi
            if [[ ! -x "$dev_script" ]]; then
                print_error "Dev script is not executable: $dev_script"
                exit 1
            fi
            print_info "Executing dev/cli.sh with arguments: $*"
            if "$dev_script" "$@"; then
                print_info "dev/cli.sh completed successfully"
            else
                local exit_code=$?
                print_error "dev/cli.sh failed with exit code $exit_code"
                exit $exit_code
            fi
            ;;
        "autocomplete")
            # Run autocomplete script
            execute_script "autocomplete.sh" "$@"
            ;;
        "help")
            show_help
            ;;
        "version")
            show_version
            ;;
        *)
            print_error "Unknown command: $command"
            echo ""
            show_usage
            exit 1
            ;;
    esac
}

# Run main function
main "$@"
