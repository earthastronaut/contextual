# Contextual Configuration File
# Uncomment and modify the variables below to customize settings

# Global context root file
# CONTEXT_ROOT=".contextual/context/README.md"

# Specifications directory (relative to project root)
# SPECS_DIR="./specs"

# Main branch name for merges
# MAIN_BRANCH="main"

# Merge commit message template (use {FEATURE_BRANCH} and {DESCRIPTION} placeholders)
# MERGE_TEMPLATE="Merge {FEATURE_BRANCH}: {DESCRIPTION}"

# Folder Analyzer - Skip Patterns
# Comma-separated list of patterns to skip (case-insensitive substring match)
# Uncomment to override defaults (cache,__pycache__,node_modules,vendor,dist,build,.pytest_cache,.tox,venv,.venv,.env,.next,.nuxt,.bundle,*.egg-info,target,.gradle)
# ANALYZE_SKIP_PATTERNS=""

# Folder Analyzer - Include Patterns
# Comma-separated list of patterns to always include (overrides skip patterns)
# ANALYZE_INCLUDE_PATTERNS=""
