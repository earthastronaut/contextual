# Contextual Configuration File Example
# Copy this file to .contextual/config and uncomment/modify as needed

# Override the contextual root directory
# CONTEXTUAL_ROOT="custom/.contextual"

# Override the context directory
# CONTEXT_DIR="custom/context"

# Override the context root file
# CONTEXT_ROOT="custom/context/README.md"

# Override the specs directory
# SPECS_DIR="custom/specs"

# Override the git repository root (rarely needed)
# GIT_REPO_ROOT="/custom/git/root"
